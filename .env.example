# Configuración Google Workspace para TúLuz
PORT=5000
RECIPIENT_EMAIL=david@tu-luz.es
DATABASE_URL=postgresql://usuario:password@host:5432/dbname

# Google Workspace Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=david@tu-luz.es
# Obtén tu contraseña de aplicación en https://myaccount.google.com/apppasswords
# Clave secreta para ver estadísticas privadas de conversiones (/api/leads-summary?key=...)
ADMIN_KEY=tu_clave_secreta_aqui

# Gmail API OAuth (la URI debe coincidir exactamente con Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://tu-luz.es/api/admin/gmail/callback
GOOGLE_GMAIL_EMAIL=davidad@tu-luz.es

# Configuración Meta Ads Webhook
META_VERIFY_TOKEN=tuluz_meta_secret_2026
META_PAGE_ACCESS_TOKEN=tu_token_de_pagina_de_meta_aqui
# Secreto de la aplicación Meta para verificar X-Hub-Signature-256 en cada POST.
META_APP_SECRET=tu_secreto_de_app_meta_aqui
